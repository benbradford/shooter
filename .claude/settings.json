{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint src --ext .ts 2>&1 | tail -20; if [ ${PIPESTATUS[0]} -ne 0 ]; then echo '{\"decision\":\"block\",\"reason\":\"ESLint errors — fix before committing\"}'; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit(src/**/*.ts)|Write(src/**/*.ts)|Edit(editor/**/*.ts)|Write(editor/**/*.ts)",
        "hooks": [
          {
            "type": "command",
            "command": "npm run build 2>&1 | tail -5"
          }
        ]
      },
      {
        "matcher": "Edit(public/levels/*.json)|Write(public/levels/*.json)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-level-json.sh"
          }
        ]
      }
    ]
  }
}
